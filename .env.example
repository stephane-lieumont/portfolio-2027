# Copy to .env and adjust. Never committed (see .gitignore).

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
WEB_ORIGIN=http://localhost:4200

DATABASE_FILE=./data/portfolio.sqlite

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=portfolio-media
# Where the API tells clients the media lives.
# In production nginx serves /medias in front of the bucket; in development the
# Angular dev server proxies the same path (apps/web/proxy.conf.json), so the
# templates never hold an origin. Seed the bucket once with:
#   pnpm --filter @portfolio/api media:seed
MEDIA_PUBLIC_URL=http://localhost:9000/portfolio-media

ADMIN_EMAIL=admin@localhost
# Generated by: pnpm --filter @portfolio/api admin:hash
ADMIN_PASSWORD_HASH=
# 32 characters minimum: openssl rand -base64 48
SESSION_SECRET=dev-only-secret-change-me-32-chars-min
SESSION_TTL_HOURS=12
