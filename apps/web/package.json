{
  "name": "@portfolio/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "content": "node scripts/content.mjs",
    "content:seed": "node scripts/content.mjs --seed",
    "dev": "node scripts/content.mjs --seed && ng serve",
    "start": "node scripts/content.mjs --seed && ng serve",
    "dev:en": "node scripts/content.mjs --seed && ng serve --configuration development-en",
    "i18n:extract": "node scripts/content.mjs --seed && ng extract-i18n",
    "build": "node scripts/content.mjs && ng build && node scripts/write-seo-files.mjs && node scripts/write-csp-hashes.mjs && node scripts/check-prerender.mjs",
    "og:images": "node scripts/og-images.mjs",
    "watch": "node scripts/content.mjs --seed && ng build --watch --configuration development",
    "test": "node scripts/content.mjs --seed && ng test && node --test \"scripts/*.test.mjs\"",
    "typecheck": "node scripts/content.mjs --seed && tsc -b --noEmit",
    "lint": "node scripts/content.mjs --seed && ng lint"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/localize": "22.1.4",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "22.1.4",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "22.1.6",
    "@portfolio/shared-types": "workspace:*",
    "lenis": "1.1.13",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "fontkit": "2.0.4",
    "jsdom": "^28.0.0",
    "sharp": "0.34.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.8",
    "wawoff2": "2.0.1",
    "zod": "^4.5.4"
  }
}
